# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Yuklab olingan fayllar saqlanadigan vaqtinchalik papka
DOWNLOAD_DIR=downloads

# Telegram Bot API fayl yuborish limiti (baytlarda: 50MB = 52428800)
MAX_FILE_SIZE_BYTES=52428800

# Instagram Geo-block va cheklovlarni chetlab o'tish uchun Cookie (Ixtiyoriy, lekin Render uchun tavsiya)
# Brauzerdan cookies.txt nusxasini olib, to'liq matnini shu yerga yoki Render Environment Variables ga qo'ying
# INSTAGRAM_COOKIES="# Netscape HTTP Cookie File..."

