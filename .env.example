# Telegram Bot Token (@BotFather orqali olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Yuklab olingan fayllar saqlanadigan vaqtinchalik papka
DOWNLOAD_DIR=downloads

# Telegram Bot API fayl yuborish limiti (baytlarda: 50MB = 52428800)
MAX_FILE_SIZE_BYTES=52428800

# Download jarayoni uchun maksimal timeout (soniyalarda)
DOWNLOAD_TIMEOUT_SECONDS=180

# YouTube / yt-dlp Bot-detection va 403 bloklarini chetlab o'tish uchun Cookie:
# Variant 1 (Tavsiya - Render uchun): Base64 formatda kodlangan Netscape cookies.txt
# Masalan: base64 -w 0 cookies.txt orqali olingan matn
# YTDL_COOKIES_B64="I05ldHNjYXBlIEhUVFA..."

# Variant 2: Oddiy matn ko'rinishidagi Netscape cookie
# YTDL_COOKIES="# Netscape HTTP Cookie File..."

# Instagram Geo-block va cheklovlarni chetlab o'tish uchun:
# INSTAGRAM_COOKIES="# Netscape HTTP Cookie File..."
